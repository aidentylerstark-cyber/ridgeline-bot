{
  "name": "pulsify-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "setup:reset": "tsx src/setup/reset-server.ts",
    "setup:welcome": "tsx src/setup/build-welcome.ts",
    "setup:join-card": "tsx src/setup/send-join-card.ts",
    "setup:owners": "tsx src/setup/build-owner-role.ts",
    "setup:onboarding": "tsx src/setup/build-onboarding.ts",
    "setup:back-office": "tsx src/setup/build-back-office.ts",
    "setup:business": "tsx src/setup/build-business.ts",
    "setup:roles": "tsx src/setup/build-role-sections.ts",
    "setup:mail": "tsx src/setup/build-mail.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.6",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  }
}
